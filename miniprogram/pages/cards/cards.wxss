.page {
  padding: 24px;
  padding-bottom: calc(24px + env(safe-area-inset-bottom));
  min-height: 100vh;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
}

.empty-title {
  font-size: 40px;
  color: var(--c-text);
}

.full {
  width: 100%;
}

.center {
  display: block;
  text-align: center;
}

.item {
  display: flex;
  align-items: center;
  margin-top: 16px;
  padding: 26px 22px;
  background: var(--c-card);
  border: 1px solid var(--color-line-soft);
  box-shadow: var(--shadow-soft);
  border-radius: 22px;
}

/* 卡包顶部入口：给"不知道拍哪一页"的人一条出路 */
.lib-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24px 22px;
  background: var(--c-primary-light);
  border-radius: 22px;
}

.lib-entry:active {
  opacity: 0.75;
}

.lib-entry-text {
  font-size: 28px;
  color: var(--c-primary);
}

.lib-entry-arrow {
  font-size: 36px;
  color: var(--c-primary);
}

.item:active {
  opacity: 0.75;
}

.item-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.item-title {
  font-size: 38px;
  font-weight: 500;
  word-break: break-all;
  line-height: 1.4;
  color: var(--c-text);
}

.item-sub {
  margin-top: 8px;
  font-size: 24px;
  color: var(--c-text-3);
}

/* ---------- 分享弹层 ---------- */
.sheet-mask {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(20, 40, 28, 0.48);
  z-index: 10;
}

.share-sheet {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 100%;
  padding: 30px 24px 40px;
  padding-bottom: calc(40px + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-radius: 28px 28px 0 0;
  max-height: 88vh;
  overflow-y: auto;
  border-top: 1px solid var(--color-line-soft);
  z-index: 11;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.sheet-title {
  font-size: 38px;
  color: var(--c-text);
}

.sheet-sub {
  margin-top: 10px;
  font-size: 28px;
  color: var(--c-text-2);
}

.sheet-tip {
  margin-top: 8px;
  font-size: 24px;
  color: var(--c-text-3);
  line-height: 1.6;
}

.lib-entry { border: 1px solid var(--c-line); gap: 12px; }
.item { border-left: 4px solid var(--c-primary); }
.empty-title { font-weight: 600; }
.empty::before {
  content: '';
  width: 68px;
  height: 88px;
  margin-bottom: 28px;
  border: 3px solid var(--c-primary);
  border-radius: 14px;
  background: var(--c-primary-light);
  box-shadow: 8px -8px 0 var(--c-bg), 10px -10px 0 var(--c-line);
}
