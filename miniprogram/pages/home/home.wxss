.page {
  /* 430 宽下左右各留 16，主卡 398（占 92.5%）；
     原来 24 只有 382，主按钮显得"缩在中间" */
  padding: 28px 16px;
  padding-bottom: calc(24px + env(safe-area-inset-bottom));
}

.head { display: flex; flex-direction: column; padding-top: 8px; }
.brand-row { display: flex; align-items: center; gap: 14px; }
.brand-steps { display: flex; align-items: flex-end; gap: 4px; width: 38px; height: 34px; flex-shrink: 0; }
.brand-step { width: 10px; border-radius: 3px 3px 1px 1px; background: var(--c-primary); height: 14px; }
.brand-step:nth-child(2) { height: 24px; }
.brand-step:nth-child(3) { height: 34px; }
.title { font-size: 44px; line-height: 1.25; font-weight: 600; color: var(--c-text); letter-spacing: 2px; }
.subtitle { margin-top: 14px; font-size: 28px; color: var(--c-text-2); }

.main {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28px 0 22px;
}

.huge {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 280px;
  padding: 28px 16px;
  border-radius: 30px;
  background: var(--c-primary);
  box-shadow: 0 6px 0 var(--c-primary-dark);
  color: var(--color-on-primary);
}
.huge-press { background: var(--c-primary-dark); }
.huge-label { margin-top: 18px; font-size: 40px; font-weight: 500; line-height: 1.4; letter-spacing: 3px; }
.huge-hint { margin-top: 8px; font-size: 24px; line-height: 1.5; color: var(--color-on-primary-soft); }

/* 首页插画：一页纸与相机，纯 CSS 绘制 */
.capture-art { position: relative; width: 120px; height: 110px; }
.paper { position: absolute; top: 0; right: 6px; width: 64px; height: 80px; padding: 14px 10px; background: #E5EEDD; border-radius: 8px; transform: rotate(10deg); }
.paper-line { height: 3px; margin-bottom: 8px; border-radius: 2px; background: #829E80; }
.paper-line.short { width: 65%; }
.cam { position: absolute; left: 0; bottom: 0; width: 96px; height: 76px; }
.cam-body { position: absolute; left: 0; bottom: 0; width: 96px; height: 66px; border: 4px solid #FFFFFF; border-radius: 14px; background: var(--c-primary); }
.cam-top { position: absolute; left: 28px; top: 0; width: 34px; height: 14px; border: 4px solid #FFFFFF; border-bottom: none; border-radius: 7px 7px 0 0; background: var(--c-primary); }
.cam-lens { position: absolute; left: 32px; bottom: 16px; width: 32px; height: 32px; border: 4px solid #FFFFFF; border-radius: 50%; }
.huge-press .cam-body, .huge-press .cam-top { background: var(--c-primary-dark); }
.ai-line { margin-top: 22px; font-size: 24px; line-height: 1.5; color: var(--c-text-3); text-align: center; }

.home-shortcuts { display: flex; gap: 14px; }
.shortcut { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; padding: 18px; border: 1px solid var(--color-line-soft); border-radius: 22px; background: var(--c-card); box-shadow: var(--shadow-soft); text-align: left; }
.shortcut-top { width: 100%; height: 30px; display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
.shortcut-label { font-size: 28px; color: var(--c-text); line-height: 1.4; font-weight: 500; }
.card-count { min-width: 30px; padding: 0 6px; border-radius: 8px; color: var(--c-primary); background: var(--c-primary-light); text-align: center; font-size: 24px; line-height: 30px; }
.shortcut-icon { position: relative; width: 30px; height: 26px; border: 2px solid var(--c-primary); border-radius: 5px; }
.cards-icon::before { content: ''; position: absolute; left: 4px; top: -7px; width: 24px; height: 20px; border-top: 2px solid var(--c-primary); border-right: 2px solid var(--c-primary); border-radius: 4px; }
.cards-icon::after { content: ''; position: absolute; left: 6px; right: 6px; top: 10px; height: 2px; background: var(--c-primary); }
.album-icon { overflow: hidden; }
.album-sun { position: absolute; top: 4px; right: 5px; width: 5px; height: 5px; border-radius: 50%; background: var(--c-primary); }
.album-hill { position: absolute; left: 4px; top: 13px; width: 18px; height: 18px; border: 2px solid var(--c-primary); border-radius: 3px; transform: rotate(45deg); }
.shortcut-press { background: var(--c-primary-light); }

.foot { padding-top: 24px; text-align: center; }
.foot .t-hint { display: block; font-size: 24px; }
.ai-more { display: inline-block; margin-top: 8px; padding: 8px 12px; font-size: 24px; color: var(--c-primary); }
.ai-more:active { opacity: 0.7; }
.center { text-align: center; }
.recv-title { font-size: 42px; line-height: 1.5; color: var(--c-text); text-align: center; }
.recv-sub { margin-top: 18px; font-size: 30px; color: var(--c-text-2); text-align: center; line-height: 1.5; }

@media (max-width: 360px) {
  .page { padding-left: 20px; padding-right: 20px; }
  .title { font-size: 40px; }
  .shortcut { padding: 16px 14px; }
}
@media (max-height: 700px) {
  .home-page { padding-top: 20px; }
  .main { padding-top: 22px; padding-bottom: 18px; }
  .huge { min-height: 250px; padding: 22px 16px; }
  .foot { padding-top: 18px; }
}
