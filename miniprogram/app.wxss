/* ===========================================================
   一步一步 · 全局设计系统
   原则：白底黑字、超大字号、单屏单任务、无装饰动效
   所有字号单位为 px（逻辑像素），不随屏幕缩放
   =========================================================== */

page {
  --c-bg: #FFFFFF;
  --c-text: #141414;
  --c-text-2: #4A4A4A;
  --c-text-3: #757575;
  --c-primary: #12447A;
  --c-primary-dark: #0D3459;
  --c-primary-light: #E8F0F9;
  --c-danger: #B3261E;
  --c-danger-light: #FBEAE8;
  --c-line: #D8D8D8;
  --c-card: #F5F5F5;

  --fs-card: 52px;
  --fs-h1: 44px;
  --fs-h2: 34px;
  --fs-btn: 32px;
  --fs-body: 28px;
  --fs-hint: 24px;

  --h-btn: 70px;
  --radius: 12px;

  background: var(--c-bg);
  color: var(--c-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: var(--fs-body);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

view, text, button, scroll-view, camera {
  box-sizing: border-box;
}

/* ---------- 页面容器 ---------- */
.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 24px;
  background: var(--c-bg);
}

.page-center {
  justify-content: center;
  align-items: stretch;
}

/* ---------- 按钮：统一重置小程序默认样式 ---------- */
button {
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: normal;
  font-size: inherit;
  font-family: inherit;
  border-radius: 0;
}

button::after {
  border: none;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: var(--h-btn);
  border-radius: var(--radius);
  font-size: var(--fs-btn);
  font-weight: 400;
  letter-spacing: 1px;
  transition: opacity 0.12s;
}

.btn:active {
  opacity: 0.72;
}

.btn-primary {
  background: var(--c-primary);
  color: #FFFFFF;
}

.btn-outline {
  background: #FFFFFF;
  color: var(--c-primary);
  border: 2px solid var(--c-primary);
}

.btn-ghost {
  background: var(--c-card);
  color: var(--c-text);
}

.btn-danger-outline {
  background: #FFFFFF;
  color: var(--c-danger);
  border: 2px solid var(--c-danger);
}

.btn[disabled] {
  opacity: 0.35;
}

/* 超大主按钮（首页拍照） */
.btn-huge {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 150px;
  border-radius: 20px;
  background: var(--c-primary);
  color: #FFFFFF;
  font-size: 38px;
}

.btn-huge:active {
  background: var(--c-primary-dark);
}

/* ---------- 文字 ---------- */
.t-h1 {
  font-size: var(--fs-h1);
  line-height: 1.3;
  color: var(--c-text);
}

.t-h2 {
  font-size: var(--fs-h2);
  line-height: 1.4;
  color: var(--c-text);
}

.t-body {
  font-size: var(--fs-body);
  color: var(--c-text-2);
}

.t-hint {
  font-size: var(--fs-hint);
  color: var(--c-text-3);
  line-height: 1.6;
}

/* ---------- 布局小工具 ---------- */
.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.row-gap {
  gap: 16px;
}

.col {
  display: flex;
  flex-direction: column;
}

.flex1 {
  flex: 1;
}

.mt-8 { margin-top: 8px; }
.mt-16 { margin-top: 16px; }
.mt-24 { margin-top: 24px; }
.mt-32 { margin-top: 32px; }
.mt-48 { margin-top: 48px; }
.mt-auto { margin-top: auto; }

.divider {
  height: 1px;
  background: var(--c-line);
  margin: 24px 0 0;
}

/* ---------- 卡片容器 ---------- */
.panel {
  background: var(--c-bg);
  border: 2px solid var(--c-line);
  border-radius: 16px;
  padding: 28px 24px;
}

/* ---------- 台阶进度（产品名的视觉落点） ---------- */
.stairs {
  display: flex;
  align-items: flex-end;
  gap: 8px;
  height: 34px;
}

.stair {
  flex: 1;
  background: var(--c-line);
  border-radius: 3px 3px 0 0;
  transition: background 0.2s;
}

.stair.on {
  background: var(--c-primary);
}

/* 每级高度做成递增的台阶 */
.stair:nth-child(1) { height: 30%; }
.stair:nth-child(2) { height: 45%; }
.stair:nth-child(3) { height: 60%; }
.stair:nth-child(4) { height: 75%; }
.stair:nth-child(5) { height: 90%; }
.stair:nth-child(6) { height: 100%; }
.stair:nth-child(n+7) { height: 100%; }

/* ---------- 加载占位（不用转圈，用呼吸点） ---------- */
.dots {
  display: flex;
  gap: 10px;
  justify-content: center;
}

.dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--c-primary);
  opacity: 0.3;
  animation: breathe 1.2s infinite;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes breathe {
  0%, 100% { opacity: 0.25; }
  50% { opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .dot { animation: none; opacity: 0.6; }
}
