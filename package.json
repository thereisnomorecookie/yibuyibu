{
  "name": "yibuyibu-app-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Unit tests for the 一步一步 WeChat mini program pages",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/*.test.js"
    ],
    "collectCoverageFrom": [
      "miniprogram/pages/reply/reply.js"
    ],
    "coverageDirectory": "coverage"
  }
}
