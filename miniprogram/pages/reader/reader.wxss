.reader {
  height: 100vh;
  padding: 0 24px;
  display: flex;
  flex-direction: column;
}

.top {
  height: 64px;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.back {
  width: 80px;
  font-size: 28px;
  color: var(--c-text-2);
  padding: 10px 0;
}

.back-press {
  opacity: 0.6;
}

.doc-title {
  flex: 1;
  text-align: center;
  font-size: 30px;
  color: var(--c-text);
  margin-right: 80px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 内容区：垂直居中，一屏一卡 */
.content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.count {
  font-size: 28px;
  color: var(--c-text-2);
  margin-bottom: 28px;
  letter-spacing: 1px;
}

/* 续读提示：短暂出现，不打断阅读 */
.resume-hint {
  margin-bottom: 18px;
  padding: 8px 20px;
  border-radius: 999px;
  background: var(--c-primary-light);
  color: var(--c-primary);
  font-size: 24px;
  line-height: 1.4;
}

.card-box {
  width: 100%;
}

.card-text {
  display: block;
  text-align: center;
  font-size: 52px;
  line-height: 1.5;
  color: var(--c-text);
  word-break: break-all;
}

.anchor {
  margin-top: 26px;
  font-size: 32px;
  line-height: 1.6;
  color: var(--c-text-2);
  text-align: center;
}

/* 底部台阶进度：极弱，但余光可见 */
.stairs-line {
  display: flex;
  gap: 6px;
  height: 24px;
  align-items: flex-end;
  flex-shrink: 0;
  margin-bottom: 14px;
}

.stairs-line .stair {
  flex: 1;
  border-radius: 3px 3px 0 0;
}

/* 操作区：主按钮独占一行，副操作在下 */
.actions {
  flex-shrink: 0;
  padding-bottom: 30px;
}

.act-main {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 84px;
  border-radius: 12px;
  background: var(--c-primary);
  color: #FFFFFF;
  font-size: 34px;
  letter-spacing: 2px;
}

.act-main:active,
.act-main-press {
  background: var(--c-primary-dark);
}

.act-row {
  display: flex;
  gap: 12px;
  margin-top: 12px;
}

.act-sub {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 64px;
  border-radius: 12px;
  font-size: 28px;
  background: var(--c-card);
  color: var(--c-text);
}

.act-sub:active,
.act-sub-press {
  opacity: 0.7;
}

.act-warn {
  background: var(--c-danger-light);
  color: var(--c-danger);
}

/* ---------- 拦截态 ---------- */
.stop-mark {
  width: 108px;
  height: 108px;
  border-radius: 50%;
  border: 6px solid var(--c-danger);
  color: var(--c-danger);
  font-size: 68px;
  line-height: 96px;
  text-align: center;
  margin-bottom: 36px;
}

.stop-title {
  font-size: 44px;
  color: var(--c-text);
  text-align: center;
  line-height: 1.4;
}

.stop-sub {
  margin-top: 20px;
  font-size: 30px;
  color: var(--c-text-2);
  text-align: center;
  line-height: 1.6;
}

.full {
  width: 100%;
}

/* ---------- 完成态 ---------- */
.done-mark {
  font-size: 76px;
  color: var(--c-primary);
  letter-spacing: 4px;
}

.done-sub {
  margin-top: 20px;
  font-size: 34px;
  color: var(--c-text-2);
  text-align: center;
}

.done-hint {
  margin-top: 12px;
  font-size: 26px;
  color: var(--c-text-3);
}

/* ---------- 问一句 ---------- */
.ask-mask {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.45);
  z-index: 20;
}

.ask-sheet {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  padding: 30px 24px 40px;
  padding-bottom: calc(40px + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-radius: 22px 22px 0 0;
  z-index: 21;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.ask-title {
  font-size: 38px;
  line-height: 1.4;
  color: var(--c-text);
}

.ask-sub {
  margin-top: 8px;
  font-size: 24px;
  color: var(--c-text-3);
}

.ask-q {
  display: flex;
  align-items: center;
  margin-top: 14px;
  padding: 22px 22px;
  background: var(--c-card);
  border-radius: 14px;
  font-size: 30px;
  line-height: 1.4;
  color: var(--c-text);
}

.ask-press {
  opacity: 0.72;
}

/* 按住说话：录音期间只换底色和文案，不卸载元素 */
.ask-mic {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 22px;
  height: 84px;
  border-radius: 14px;
  background: var(--c-primary);
}

.ask-mic.on {
  background: var(--c-primary-dark);
}

.ask-mic-text {
  font-size: 32px;
  letter-spacing: 1px;
  color: #FFFFFF;
}

.ask-note {
  margin-top: 14px;
  font-size: 24px;
  line-height: 1.5;
  color: var(--c-text-3);
  text-align: center;
}

.ask-qecho {
  font-size: 24px;
  line-height: 1.5;
  color: var(--c-text-3);
}

.ask-answer {
  margin-top: 14px;
  font-size: 40px;
  line-height: 1.5;
  color: var(--c-text);
  word-break: break-all;
}
