<!-- 正在取别人分享的卡组 -->
<view class="page page-center" wx:if="{{receiving}}">
  <view class="dots">
    <view class="dot"></view>
    <view class="dot"></view>
    <view class="dot"></view>
  </view>
  <text class="t-hint center mt-24">正在打开这组卡</text>
</view>

<!-- 取不到（过期 / 链接不完整 / 断网） -->
<view class="page page-center" wx:elif="{{receiveError}}">
  <text class="recv-title">{{receiveError}}</text>
  <view class="mt-48 full">
    <button class="btn btn-primary" hover-class="none" bindtap="dismissReceive">回首页</button>
  </view>
</view>

<!-- 收到卡组：全屏确认 -->
<view class="page page-center" wx:elif="{{receive}}">
  <text class="recv-title">给你发来一组卡</text>
  <text class="recv-sub">{{receive.title}} · 共 {{receive.count}} 步</text>

  <view class="mt-48 full">
    <button class="btn btn-primary" hover-class="none" bindtap="saveReceived">存起来</button>
  </view>
  <view class="mt-24 full">
    <button class="btn btn-ghost" hover-class="none" bindtap="dismissReceive">不存了</button>
  </view>
</view>

<!-- 首页默认态 -->
<view class="page home-page" wx:else>
  <view class="head" bindlongpress="onLongPressHead">
    <view class="brand-row">
      <view class="brand-steps" aria-hidden="true">
        <view class="brand-step"></view>
        <view class="brand-step"></view>
        <view class="brand-step"></view>
      </view>
      <text class="title">一步一步</text>
    </view>
    <text class="subtitle">拍一张纸，念给你听</text>
  </view>

  <view class="main">
    <button class="huge" bindtap="goCapture" hover-class="huge-press" hover-stay-time="60">
      <view class="capture-art" aria-hidden="true">
        <view class="paper"><view class="paper-line"></view><view class="paper-line"></view><view class="paper-line short"></view></view>
        <view class="cam">
        <view class="cam-body"></view>
        <view class="cam-lens"></view>
        <view class="cam-top"></view>
        </view>
      </view>
      <text class="huge-label">拍一张</text>
      <text class="huge-hint">请确保拍摄环境光线充足</text>
    </button>

    <text class="ai-line">会看 · 会拆步 · 会念给您听</text>
  </view>

  <view class="home-shortcuts">
    <button class="shortcut" hover-class="shortcut-press" bindtap="goCards">
      <view class="shortcut-top"><view class="shortcut-icon cards-icon" aria-hidden="true"></view><text class="card-count">{{count}}</text></view>
      <text class="shortcut-label">我的卡</text>
    </button>
    <button class="shortcut" hover-class="shortcut-press" bindtap="chooseAlbum">
      <view class="shortcut-top"><view class="shortcut-icon album-icon" aria-hidden="true"><view class="album-sun"></view><view class="album-hill"></view></view></view>
      <text class="shortcut-label">从相册选</text>
    </button>
  </view>

  <view class="foot">
    <text class="t-hint">{{ttsHint}}</text>
    <view class="ai-more" bindtap="showAbilities">它还会什么 ›</view>
  </view>
</view>
