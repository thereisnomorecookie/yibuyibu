.page-cam {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: #000000;
  overflow: hidden;
}

.cam {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* 遮罩层不接收事件，避免挡住下方操作 */
.mask-layer {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 2;
}

.frame {
  position: absolute;
  left: 11%;
  top: 8%;
  width: 78%;
  height: calc(100% - 360px);
  border-radius: 8px;
  /* 用一个超大外阴影做出"框外压暗"的效果，无需四块遮罩 */
  box-shadow: 0 0 0 3000px rgba(0, 0, 0, 0.55);
}

.corner {
  position: absolute;
  width: 34px;
  height: 34px;
  border: 5px solid #D7E8D8;
}

.corner.tl { left: -2px; top: -2px; border-right: none; border-bottom: none; border-radius: 8px 0 0 0; }
.corner.tr { right: -2px; top: -2px; border-left: none; border-bottom: none; border-radius: 0 8px 0 0; }
.corner.bl { left: -2px; bottom: -2px; border-right: none; border-top: none; border-radius: 0 0 0 8px; }
.corner.br { right: -2px; bottom: -2px; border-left: none; border-top: none; border-radius: 0 0 8px 0; }

.frame-tip {
  position: absolute;
  left: 0;
  bottom: 290px;
  width: 100%;
  text-align: center;
  font-size: 28px;
  color: #FFFFFF;
  letter-spacing: 1px;
}

.bottom-bar {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  /* 430×932：240 高 + 贴底排列，快门中心落在距底约 159px，
     接近系统相机；原来 270 高又垂直居中，三样东西装不下被顶到 244px */
  height: 240px;
  padding-bottom: calc(36px + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  z-index: 3;
}

.shutter-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.shutter {
  width: 96px;
  height: 96px;
  border-radius: 50%;
  background: #FFFFFF;
  border: 7px solid var(--c-primary-light);
  box-shadow: 0 0 0 4px var(--c-primary);
}

.shutter-press {
  background: #DDDDDD;
  transform: scale(0.96);
}

.shutter-label {
  margin-top: 10px;
  font-size: 24px;
  line-height: 1.3;
  color: #FFFFFF;
}

/* 相册入口从竖排里移出来，放到快门左侧，
   否则它会和"拍"字一起把快门往上顶 */
.album-entry {
  position: absolute;
  left: 20px;
  bottom: calc(88px + env(safe-area-inset-bottom));
  padding: 12px 18px;
  font-size: 26px;
  color: #FFFFFF;
  text-decoration: none;
  background: rgba(0, 0, 0, 0.32);
  border-radius: 16px;
}

.sample-entry {
  position: absolute;
  right: 20px;
  /* 12 太贴底，加 8px 让它和快门、相册在同一视觉带上 */
  bottom: calc(20px + env(safe-area-inset-bottom));
  z-index: 4;
  padding: 12px 18px;
  font-size: 24px;
  color: #FFFFFF;
  border: 1px solid rgba(255, 255, 255, 0.45);
  border-radius: 16px;
}

/* ---------- 处理态 ---------- */

.busy-stairs {
  width: 70%;
  height: 60px;
  margin: 0 auto;
}

.busy-title {
  margin-top: 40px;
  font-size: 40px;
  color: var(--c-text);
  text-align: center;
  line-height: 1.5;
}

/* AI 的判断结果：副标题是文档名，注脚是"几步拿不准" */
.busy-sub {
  margin-top: 12px;
  font-size: 28px;
  color: var(--c-text-2);
  text-align: center;
  line-height: 1.4;
}

.busy-note {
  margin-top: 28px;
  padding: 0 12px;
  font-size: 26px;
  color: var(--c-text-2);
  text-align: center;
  line-height: 1.6;
}

.center {
  text-align: center;
}

/* ---------- 失败态 ---------- */

.fail-title {
  font-size: 42px;
  color: var(--c-text);
  text-align: center;
  line-height: 1.4;
}
