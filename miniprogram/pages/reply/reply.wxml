<view class="page" wx:if="{{loading}}">
  <view class="page-center flex1">
    <view class="dots">
      <view class="dot"></view>
      <view class="dot"></view>
      <view class="dot"></view>
    </view>
  </view>
</view>

<view class="page page-center" wx:elif="{{error}}">
  <text class="err-title">{{error}}</text>
  <text class="t-hint center mt-16">让孩子在小程序里再发一次就行</text>
</view>

<view class="page" wx:elif="{{sent}}">
  <view class="page-center flex1">
    <text class="ok-title">已经发过去了</text>
    <text class="t-body center mt-16">它会自己念给妈听</text>
    <view class="mt-48 full">
      <button class="btn btn-ghost" hover-class="none" bindtap="again">再补一句</button>
    </view>

    <button class="share-link mt-24" open-type="share" hover-class="none">让朋友也用上</button>
  </view>
</view>

<view class="page" wx:else>
  <text class="title">妈卡在第 {{help.stepNo}} 步</text>
  <text class="t-hint mt-8">共 {{help.stepTotal}} 步，她只差这一步</text>

  <view class="card mt-24">
    <text class="card-text">{{help.stepText}}</text>
    <text class="anchor" wx:if="{{help.stepAnchor}}">{{help.stepAnchor}}</text>
  </view>

  <view class="tip mt-24">
    <text class="t-hint">说一句她能听懂的话。别用「那个」，说清楚是哪个。</text>
  </view>

  <textarea
    class="input mt-16"
    value="{{text}}"
    bindinput="onInput"
    placeholder="比如：那个圆盖往左拧"
    placeholder-class="ph"
    maxlength="200"
    auto-height></textarea>

  <view class="mt-24 full">
    <button class="btn btn-primary" hover-class="none" disabled="{{sending || !text}}" bindtap="send">{{sending ? '正在发…' : '发过去'}}</button>
  </view>

  <view class="signature">
    <text class="sig-text">帮爸妈看懂说明书 · 一步一步</text>
  </view>
</view>
