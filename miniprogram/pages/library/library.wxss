.page {
  padding: 24px;
  padding-bottom: calc(24px + env(safe-area-inset-bottom));
  min-height: 100vh;
}

.lead {
  display: block;
  font-size: 34px;
  line-height: 1.4;
  color: var(--c-text);
}

.lead-sub {
  display: block;
  margin-top: 10px;
  font-size: 26px;
  line-height: 1.5;
  color: var(--c-text-3);
}

.group {
  margin-top: 4px;
}

.group-title {
  display: block;
  margin-top: 34px;
  font-size: 26px;
  color: var(--c-text-3);
  letter-spacing: 1px;
}

.item {
  display: flex;
  align-items: center;
  margin-top: 12px;
  padding: 26px 22px;
  background: var(--c-card);
  border: 1px solid var(--color-line-soft);
  box-shadow: var(--shadow-soft);
  border-radius: 22px;
}

.item:active {
  opacity: 0.75;
}

.item-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.item-title {
  font-size: 38px;
  font-weight: 500;
  word-break: break-all;
  line-height: 1.4;
  color: var(--c-text);
}

.item-sub {
  margin-top: 8px;
  font-size: 24px;
  color: var(--c-text-3);
}

.item-arrow {
  margin-left: 12px;
  font-size: 40px;
  color: var(--c-text-3);
}

.center {
  display: block;
  text-align: center;
}

/* ---------- 弹层 ---------- */
.sheet-mask {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(20, 40, 28, 0.48);
  z-index: 10;
}

.sheet {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 100%;
  padding: 30px 24px 40px;
  padding-bottom: calc(40px + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-radius: 28px 28px 0 0;
  max-height: 88vh;
  overflow-y: auto;
  border-top: 1px solid var(--color-line-soft);
  z-index: 11;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.sheet-title {
  font-size: 38px;
  color: var(--c-text);
}

.sheet-sub {
  margin-top: 8px;
  font-size: 24px;
  color: var(--c-text-3);
}

.sheet-label {
  margin-top: 28px;
  font-size: 24px;
  color: var(--c-text-3);
}

.sheet-hint {
  margin-top: 10px;
  font-size: 30px;
  line-height: 1.6;
  color: var(--c-text);
}

.lead { font-weight: 500; }
.group-title { padding-left: 12px; border-left: 4px solid var(--c-primary); color: var(--c-primary); }
.item-arrow { color: var(--c-primary); }
