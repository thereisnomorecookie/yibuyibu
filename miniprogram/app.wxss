/* ===========================================================
   一步一步 · 全局设计系统
   原则：米白底、深绿主色、超大字号、单屏单任务
   所有字号单位为 px（逻辑像素），不随屏幕缩放
   =========================================================== */

page {
  --color-primary: #286348;
  --color-primary-dark: #194B35;
  --color-primary-light: #E6EFE5;
  --color-primary-alt: #22563C;
  --color-on-primary: #FFFFFF;
  --color-on-primary-soft: #E3EEE3;
  --color-on-primary-hint: #D7E8D8;

  --color-surface: #F7F8F2;
  --color-surface-2: #FFFFFF;
  --color-line: #CBD8C9;
  --color-line-soft: #E1E7DB;
  --color-text: #203B2D;
  --color-text-2: #4B6051;
  --color-text-3: #60705F;

  --color-danger: #A4382D;
  --color-danger-light: #F9EBE5;
  --color-step-idle: #CBD8C9;
  --color-step-done: var(--color-primary);
  --shadow-soft: 0 6px 22px rgba(32, 59, 45, 0.05);

  --c-bg: var(--color-surface);
  --c-text: var(--color-text);
  --c-text-2: var(--color-text-2);
  --c-text-3: var(--color-text-3);
  --c-primary: var(--color-primary);
  --c-primary-dark: var(--color-primary-dark);
  --c-primary-light: var(--color-primary-light);
  --c-danger: var(--color-danger);
  --c-danger-light: var(--color-danger-light);
  --c-line: var(--color-line);
  --c-card: var(--color-surface-2);

  --fs-card: 52px;
  --fs-h1: 44px;
  --fs-h2: 34px;
  --fs-btn: 32px;
  --fs-body: 28px;
  --fs-hint: 24px;

  --h-btn: 70px;
  --radius: 18px;

  background: var(--c-bg);
  color: var(--c-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: var(--fs-body);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

view, text, button, scroll-view, camera {
  box-sizing: border-box;
}

/* ---------- 页面容器 ---------- */
.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 24px;
  padding-bottom: calc(24px + env(safe-area-inset-bottom));
  background: var(--c-bg);
}

.page-center {
  justify-content: center;
  align-items: stretch;
}

/* ---------- 按钮：统一重置小程序默认样式 ---------- */
button {
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: normal;
  font-size: inherit;
  font-family: inherit;
  border-radius: 0;
}

button::after {
  border: none;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: var(--h-btn);
  border-radius: var(--radius);
  font-size: var(--fs-btn);
  min-height: var(--h-btn);
  height: auto;
  padding: 10px 16px;
  font-weight: 500;
  letter-spacing: 1px;
  line-height: 1.4;
  transition: background 0.12s, opacity 0.12s;
}

.btn:active {
  opacity: 0.72;
}

.btn-primary {
  background: var(--c-primary);
  color: var(--color-on-primary);
  box-shadow: 0 4px 0 var(--c-primary-dark);
}

.btn-primary:active {
  background: var(--c-primary-dark);
  opacity: 1;
}

.btn-outline {
  background: #FFFFFF;
  color: var(--c-primary);
  border: 2px solid var(--c-primary);
}

.btn-ghost {
  background: var(--c-card);
  color: var(--c-primary);
  border: 1px solid var(--color-line-soft);
}

.btn-danger-outline {
  background: #FFFFFF;
  color: var(--c-danger);
  border: 2px solid var(--c-danger);
}

.btn[disabled] {
  opacity: 0.35;
}

/* 超大主按钮（首页拍照） */
.btn-huge {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 150px;
  border-radius: 20px;
  background: var(--c-primary);
  color: #FFFFFF;
  font-size: 38px;
}

.btn-huge:active {
  background: var(--c-primary-dark);
}

/* ---------- 文字 ---------- */
.t-h1 {
  font-size: var(--fs-h1);
  line-height: 1.3;
  color: var(--c-text);
}

.t-h2 {
  font-size: var(--fs-h2);
  line-height: 1.4;
  color: var(--c-text);
}

.t-body {
  font-size: var(--fs-body);
  color: var(--c-text-2);
}

.t-hint {
  font-size: var(--fs-hint);
  color: var(--c-text-3);
  line-height: 1.6;
}

/* ---------- 布局小工具 ---------- */
.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.row-gap {
  gap: 16px;
}

.col {
  display: flex;
  flex-direction: column;
}

.flex1 {
  flex: 1;
}

.mt-8 { margin-top: 8px; }
.mt-16 { margin-top: 16px; }
.mt-24 { margin-top: 24px; }
.mt-32 { margin-top: 32px; }
.mt-48 { margin-top: 48px; }
.mt-auto { margin-top: auto; }

.divider {
  height: 1px;
  background: var(--c-line);
  margin: 24px 0 0;
}

/* ---------- 卡片容器 ---------- */
.panel {
  background: var(--c-card);
  border: 1px solid var(--c-line);
  border-radius: 22px;
  padding: 28px 24px;
}

/* ---------- 台阶进度（产品名的视觉落点） ---------- */
.stairs {
  display: flex;
  align-items: flex-end;
  gap: 8px;
  height: 34px;
}

.stair {
  flex: 1;
  background: var(--c-line);
  border-radius: 3px 3px 0 0;
  transition: background 0.2s;
}

.stair.on {
  background: var(--c-primary);
}

/* 每级高度做成递增的台阶 */
.stair:nth-child(1) { height: 30%; }
.stair:nth-child(2) { height: 45%; }
.stair:nth-child(3) { height: 60%; }
.stair:nth-child(4) { height: 75%; }
.stair:nth-child(5) { height: 90%; }
.stair:nth-child(6) { height: 100%; }
.stair:nth-child(n+7) { height: 100%; }

/* ---------- 加载占位（不用转圈，用呼吸点） ---------- */
.dots {
  display: flex;
  gap: 10px;
  justify-content: center;
}

.dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--c-primary);
  opacity: 0.3;
  animation: breathe 1.2s infinite;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes breathe {
  0%, 100% { opacity: 0.25; }
  50% { opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .dot { animation: none; opacity: 0.6; }
}

/* 无障碍：原生按钮的焦点可见轮廓 */
button:focus-visible {
  outline: 3px solid var(--c-primary);
  outline-offset: 4px;
}

.full { width: 100%; }

@media (prefers-reduced-motion: reduce) {
  .btn, .stair { transition: none; }
}
