.page-cam {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: #000000;
  overflow: hidden;
}

.cam {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* 遮罩层不接收事件，避免挡住下方操作 */
.mask-layer {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 2;
}

.frame {
  position: absolute;
  left: 11%;
  top: 16%;
  width: 78%;
  height: 54%;
  border-radius: 8px;
  /* 用一个超大外阴影做出"框外压暗"的效果，无需四块遮罩 */
  box-shadow: 0 0 0 3000px rgba(0, 0, 0, 0.55);
}

.corner {
  position: absolute;
  width: 34px;
  height: 34px;
  border: 5px solid #FFFFFF;
}

.corner.tl { left: -2px; top: -2px; border-right: none; border-bottom: none; border-radius: 8px 0 0 0; }
.corner.tr { right: -2px; top: -2px; border-left: none; border-bottom: none; border-radius: 0 8px 0 0; }
.corner.bl { left: -2px; bottom: -2px; border-right: none; border-top: none; border-radius: 0 0 0 8px; }
.corner.br { right: -2px; bottom: -2px; border-left: none; border-top: none; border-radius: 0 0 8px 0; }

.frame-tip {
  position: absolute;
  left: 0;
  top: calc(16% + 54% + 20px);
  width: 100%;
  text-align: center;
  font-size: 30px;
  color: #FFFFFF;
  letter-spacing: 1px;
}

.bottom-bar {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 240px;
  padding-bottom: 40px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 3;
}

.shutter-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.shutter {
  width: 140px;
  height: 140px;
  border-radius: 50%;
  background: #FFFFFF;
  border: 8px solid rgba(255, 255, 255, 0.4);
}

.shutter-press {
  background: #DDDDDD;
  transform: scale(0.96);
}

.shutter-label {
  margin-top: 12px;
  font-size: 26px;
  color: #FFFFFF;
}

.album-entry {
  margin-top: 18px;
  font-size: 28px;
  color: #FFFFFF;
  text-decoration: underline;
  padding: 12px 20px;
}

.sample-entry {
  position: absolute;
  right: 20px;
  bottom: 24px;
  z-index: 4;
  padding: 12px 18px;
  font-size: 24px;
  color: rgba(255, 255, 255, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.45);
  border-radius: 8px;
}

/* ---------- 处理态 ---------- */

.busy-stairs {
  width: 70%;
  height: 60px;
  margin: 0 auto;
}

.busy-title {
  margin-top: 40px;
  font-size: 40px;
  color: var(--c-text);
  text-align: center;
  line-height: 1.5;
}

.center {
  text-align: center;
}

/* ---------- 失败态 ---------- */

.fail-title {
  font-size: 42px;
  color: var(--c-text);
  text-align: center;
  line-height: 1.4;
}
